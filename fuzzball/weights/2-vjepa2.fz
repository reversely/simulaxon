version: v4
volumes:
  data:
    use: team13
    name: simulaxon-data
    ingress:
      - source:
          uri: hf://facebook/vjepa2-vitg-fpc64-256
        destination:
          uri: file://weights/facebook--vjepa2-vitg-fpc64-256
        policy:
          timeout:
            execute: 3h
jobs:
  sizes:
    image:
      uri: docker://alpine:3.20
    resource:
      cpu:
        cores: 1
      memory:
        size: 1GiB
    mounts:
      /data:
        volume: data
    script: |
      #!/bin/sh
      du -sh /data/weights/* /data/weights/*/text_tokenizer 2>/dev/null || true

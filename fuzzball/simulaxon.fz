version: v4
# Simulaxon's long-running task (the team's sketch, batch mode): the planner (Nemotron on vLLM) and the app server the
# user talks to. The app launches rendering as batch tasks (observer.fz) that read and write the same volume.
# render-score.fz adds an optional always-on render service for previews.
# Needs: the repo at /data/src/simulaxon (streamed in with receive.fz) and the Nemotron weights (weights/5-*.fz). The app's URL: fuzzball workflow endpoints <workflow-id>.
# Fuzzball 4.3 has no persistent endpoints, so the URL changes with each new workflow.
volumes:
  data:
    use: team13
    name: simulaxon-data

jobs:
  build-ui:
    image:
      uri: docker://node:24-bookworm-slim
    resource:
      cpu:
        cores: 4
      memory:
        size: 8GiB
    mounts:
      /data:
        volume: data
    script: |
      #!/bin/sh
      set -e
      cd /data/src/simulaxon/frontend
      npm ci --no-audit --no-fund
      npm run build
      rm -rf /data/app/dist.new && mkdir -p /data/app && cp -r dist /data/app/dist.new
      rm -rf /data/app/dist && mv /data/app/dist.new /data/app/dist
      ls -la /data/app/dist

services:
  planner:
    # Nemotron 3 Super NVFP4 on one GB10, with the settings NVIDIA's model card gives for DGX Spark
    # (huggingface.co/nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4, "vLLM on DGX Spark"), served from /data/weights.
    image:
      uri: docker://vllm/vllm-openai:v0.27.1
    persist: true
    resource:
      cpu:
        cores: 8   # the team's second node has 10 free cores beside the app server
      memory:
        size: 100GiB
      devices:
        nvidia.com/gpu: 1
    mounts:
      /data:
        volume: data
    env:
      - HF_HUB_OFFLINE=1
      - VLLM_NVFP4_GEMM_BACKEND=marlin
      - VLLM_FLASHINFER_ALLREDUCE_BACKEND=trtllm
      - VLLM_USE_FLASHINFER_MOE_FP4=0
      - VLLM_ENGINE_READY_TIMEOUT_S=1800   # loading 80 GB from the volume alone takes about 9 minutes
    script: |
      #!/bin/sh
      (sh /data/src/simulaxon/fuzzball/gpu-log.sh $$ &)   # GPU readings and commands: fuzzball/gpu-usage.py
      M=/data/weights/nvidia--nemotron-3-super-120b-a12b-nvfp4
      exec vllm serve "$M" \
        --served-model-name nvidia/nemotron-3-super \
        --host 0.0.0.0 --port 8000 \
        --async-scheduling --dtype auto --kv-cache-dtype fp8 \
        --tensor-parallel-size 1 --trust-remote-code \
        --gpu-memory-utilization 0.75 \
        --enable-chunked-prefill --max-num-seqs 4 --max-model-len 65536 \
        --moe-backend marlin --mamba_ssm_cache_dtype float16 --quantization fp4 \
        --reasoning-parser-plugin "$M/super_v3_reasoning_parser.py" --reasoning-parser super_v3 \
        --enable-auto-tool-choice --tool-call-parser qwen3_coder \
        --speculative_config '{"method":"mtp","num_speculative_tokens":3,"model":"/data/weights/nvidia--nemotron-3-super-120b-a12b-bf16-mtpv2","moe_backend":"triton"}'
    network:
      ports:
        - name: openai
          port: 8000
    readiness-probe:
      http-get:
        path: /health
        port: 8000
      initial-delay-seconds: 120
      period-seconds: 30
      failure-threshold: 60

  app-server:
    image:
      uri: docker://python:3.12-slim
    persist: true
    depends-on:
      - name: build-ui
        status: FINISHED
    resource:
      cpu:
        cores: 4
      memory:
        size: 8GiB   # the lab server loads pandas, SciPy and nilearn beside DuckDB
    mounts:
      /data:
        volume: data
    env:
      - SIMULAXON_DATA=/data
      - SIMULAXON_HOME=/data   # backend/data (files, fetched datasets, chats) and feasibility/ (runs, indexes) under it
      - SIMULAXON_UI=/data/app/dist
      - HOME=/tmp
      - PLANNER_URL=http://planner:8000/v1
      - PLANNER_MODEL=nvidia/nemotron-3-super
      - FUZZBALL=/data/bin/fuzzball
    script: |
      #!/bin/sh
      set -e
      mkdir -p /data/bin /data/log
      # The cluster's CLI, for submitting runs with the injected FB_TOKEN (docs: In-Workflow API Access).
      python3 - <<'PY'
      import os, urllib.request
      req = urllib.request.Request('https://ui.fb-hack.civilfritz.net/api/download/cli/linux/arm64',
                                   headers={'Cookie': 'fwi.access-token=' + os.environ['FB_TOKEN']})
      open('/data/bin/fuzzball.part', 'wb').write(urllib.request.urlopen(req, timeout=600).read())
      os.chmod('/data/bin/fuzzball.part', 0o755); os.replace('/data/bin/fuzzball.part', '/data/bin/fuzzball')
      PY
      pip install --no-cache-dir -q -r /data/src/simulaxon/services/app-server/requirements.txt
      # TRIBE v2's plotting code (brain-map pictures, lab/maps.py) imports torch; the CPU build is enough here.
      pip install --no-cache-dir -q torch --index-url https://download.pytorch.org/whl/cpu
      # The lab cuts and encodes clips with ffmpeg; the slim image has none, so use the static build the TRIBE environment carries.
      mkdir -p $HOME/bin && ln -sf $(/data/envs/tribe/bin/python -c "import imageio_ffmpeg; print(imageio_ffmpeg.get_ffmpeg_exe())") $HOME/bin/ffmpeg
      export PATH=$HOME/bin:$PATH
      cd /data/src/simulaxon/services/app-server
      # The lab server (app_server/lab/serve.py): the tools, the event stream, the UI, and the cluster dashboard at /dashboard.
      # Its agent runs on the planner (lab/planner_agent.py), since the cluster has no Claude Code.
      # Restarted in place after a code update, so the planner keeps running:
      #   fuzzball workflow exec <id> app-server -- python3 -c "import os; [os.kill(int(p), 15) for p in os.listdir('/proc') if p.isdigit() and open(f'/proc/{p}/cmdline', 'rb').read().startswith(b'python\\x00-m\\x00app_server.lab.serve')]"
      while true; do python -m app_server.lab.serve --host 0.0.0.0 --port 8791 --db /data/log/lab.duckdb || echo "app server exited ($?); restarting"; sleep 2; done   # || keeps set -e from ending the loop
    network:
      ports:
        - name: web
          port: 8791
      endpoints:
        - name: simulaxon
          port-name: web
          type: subdomain
          protocol: http
          scope: group
    readiness-probe:
      http-get:
        path: /tools
        port: 8791
      initial-delay-seconds: 30
      period-seconds: 10
      failure-threshold: 60   # the first start installs about 300 MB of packages

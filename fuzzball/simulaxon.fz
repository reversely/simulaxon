version: v4
# Simulaxon's services (docs/image.png): render-score, the planner and the app server.
# render-score and the planner each take a node's one GB10, so Fuzzball always places them on different nodes (Node A
# and Node B in the picture); the app server needs no GPU and goes wherever there is room.
# Needs: the repo at /data/src/simulaxon (streamed in with receive.fz), the weights (weights/*.fz), and render-score's
# environments and graphics libraries (render-env.fz). The app's URL: fuzzball workflow endpoints <workflow-id>.
# Fuzzball 4.3 has no persistent endpoints, so the URL changes with each new workflow.
volumes:
  data:
    use: team13
    name: simulaxon-data

jobs:
  build-ui:
    image:
      uri: docker://node:24-bookworm-slim
    resource:
      cpu:
        cores: 4
      memory:
        size: 8GiB
    mounts:
      /data:
        volume: data
    script: |
      #!/bin/sh
      set -e
      cd /data/src/simulaxon/frontend
      npm ci --no-audit --no-fund
      npm run build
      rm -rf /data/app/dist.new && mkdir -p /data/app && cp -r dist /data/app/dist.new
      rm -rf /data/app/dist && mv /data/app/dist.new /data/app/dist
      ls -la /data/app/dist

services:
  render-score:
    # Isaac Sim 6.2 renders, Cosmos3-Nano restyles, TRIBE v2 reads (services/render-score/server.py). NVIDIA's Isaac Sim
    # container supplies the system libraries; the graphics libraries and the three Python environments are on /data.
    image:
      uri: docker://nvcr.io/nvidia/isaac-sim:6.2.0
    persist: true
    resource:
      cpu:
        cores: 16
      memory:
        size: 96GiB
      devices:
        nvidia.com/gpu: 1
    mounts:
      /data:
        volume: data
    env:
      - HOME=/tmp/home
      - SIMULAXON_DATA=/data
      - HF_HUB_CACHE=/data/weights/hf/hub
      - HF_HUB_OFFLINE=1
      - TRIBE_CACHE=/data/weights/tribe-cache
      - LD_LIBRARY_PATH=/data/envs/nvidia-gl/lib:/gpu-libs
      - VK_ICD_FILENAMES=/data/envs/nvidia-gl/share/nvidia_icd.json
      - VK_DRIVER_FILES=/data/envs/nvidia-gl/share/nvidia_icd.json
      - __EGL_VENDOR_LIBRARY_FILENAMES=/data/envs/nvidia-gl/share/10_nvidia.json
      - OMNI_KIT_ACCEPT_EULA=YES
    script: |
      #!/bin/bash
      set -e
      mkdir -p $HOME/bin && ln -sfn /data/studies/observer $HOME/data
      ln -sf $(/data/envs/tribe/bin/python -c "import imageio_ffmpeg; print(imageio_ffmpeg.get_ffmpeg_exe())") $HOME/bin/ffmpeg
      export PATH=$HOME/bin:$PATH
      cd /data/src/simulaxon/services/render-score
      exec /data/envs/tribe/bin/python server.py --host 0.0.0.0 --port 8100
    network:
      ports:
        - name: http
          port: 8100
    readiness-probe:
      http-get:
        path: /health
        port: 8100
      initial-delay-seconds: 10
      period-seconds: 10
      failure-threshold: 30

  planner:
    # Nemotron 3 Super NVFP4 on one GB10, with the settings NVIDIA's model card gives for DGX Spark
    # (huggingface.co/nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4, "vLLM on DGX Spark"), served from /data/weights.
    image:
      uri: docker://vllm/vllm-openai:v0.27.1
    persist: true
    resource:
      cpu:
        cores: 16
      memory:
        size: 100GiB
      devices:
        nvidia.com/gpu: 1
    mounts:
      /data:
        volume: data
    env:
      - HF_HUB_OFFLINE=1
      - VLLM_NVFP4_GEMM_BACKEND=marlin
      - VLLM_FLASHINFER_ALLREDUCE_BACKEND=trtllm
      - VLLM_USE_FLASHINFER_MOE_FP4=0
    script: |
      #!/bin/sh
      M=/data/weights/nvidia--nemotron-3-super-120b-a12b-nvfp4
      exec vllm serve "$M" \
        --served-model-name nvidia/nemotron-3-super \
        --host 0.0.0.0 --port 8000 \
        --async-scheduling --dtype auto --kv-cache-dtype fp8 \
        --tensor-parallel-size 1 --trust-remote-code \
        --gpu-memory-utilization 0.85 \
        --enable-chunked-prefill --max-num-seqs 4 --max-model-len 65536 \
        --moe-backend marlin --mamba_ssm_cache_dtype float16 --quantization fp4 \
        --reasoning-parser-plugin "$M/super_v3_reasoning_parser.py" --reasoning-parser super_v3 \
        --enable-auto-tool-choice --tool-call-parser qwen3_coder
    network:
      ports:
        - name: openai
          port: 8000
    readiness-probe:
      http-get:
        path: /health
        port: 8000
      initial-delay-seconds: 120
      period-seconds: 30
      failure-threshold: 60

  app-server:
    image:
      uri: docker://python:3.12-slim
    persist: true
    depends-on:
      - name: build-ui
        status: FINISHED
    resource:
      cpu:
        cores: 4
      memory:
        size: 4GiB
    mounts:
      /data:
        volume: data
    env:
      - SIMULAXON_DATA=/data
      - SIMULAXON_UI=/data/app/dist
      - HOME=/tmp
      - PLANNER_URL=http://planner:8000/v1
      - PLANNER_MODEL=nvidia/nemotron-3-super
      - RENDER_SCORE_URL=http://render-score:8100
      - FUZZBALL=/data/bin/fuzzball
    script: |
      #!/bin/sh
      set -e
      mkdir -p /data/bin /data/log
      # The cluster's CLI, for submitting runs with the injected FB_TOKEN (docs: In-Workflow API Access).
      python3 - <<'PY'
      import os, urllib.request
      req = urllib.request.Request('https://ui.fb-hack.civilfritz.net/api/download/cli/linux/arm64',
                                   headers={'Cookie': 'fwi.access-token=' + os.environ['FB_TOKEN']})
      open('/data/bin/fuzzball.part', 'wb').write(urllib.request.urlopen(req, timeout=600).read())
      os.chmod('/data/bin/fuzzball.part', 0o755); os.replace('/data/bin/fuzzball.part', '/data/bin/fuzzball')
      PY
      pip install --no-cache-dir -q -r /data/src/simulaxon/services/app-server/requirements.txt
      cd /data/src/simulaxon/services/app-server
      exec python -m app_server.server --host 0.0.0.0 --port 8791
    network:
      ports:
        - name: web
          port: 8791
      endpoints:
        - name: simulaxon
          port-name: web
          type: subdomain
          protocol: http
          scope: group
    readiness-probe:
      http-get:
        path: /api/datasets
        port: 8791
      initial-delay-seconds: 20
      period-seconds: 10
      failure-threshold: 30

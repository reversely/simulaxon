{
 "uid": "simulaxon",
 "title": "Simulaxon",
 "tags": [
  "simulaxon"
 ],
 "timezone": "browser",
 "refresh": "30s",
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Compute, measured per stage",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 26
  },
  {
   "type": "stat",
   "title": "GPU-hours in range",
   "description": "Busy GPU time summed over every service in the selected range: nvidia-smi utilisation integrated over time, 15 s samples.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(sum by (job) (sum_over_time((simulaxon_gpu_utilization_percent / 100)[$__range:15s])) * 15) / 3600",
     "legendFormat": "GPU-hours",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "h"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name"
   },
   "id": 27
  },
  {
   "type": "stat",
   "title": "Busy while held",
   "description": "Mean GPU utilisation while a service holds its GPU, in the selected range. A series exists only while the job runs, so idle time outside a job is not counted.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "avg(avg_over_time(simulaxon_gpu_utilization_percent[$__range]))",
     "legendFormat": "busy",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "orange",
        "value": null
       },
       {
        "color": "green",
        "value": 50
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name"
   },
   "id": 28
  },
  {
   "type": "stat",
   "title": "Planner tokens per second",
   "description": "Nemotron 3 Super generation rate, vLLM with MTP speculative decoding (#2), over the last 5 minutes with traffic.",

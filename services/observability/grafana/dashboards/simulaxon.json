{
 "uid": "simulaxon",
 "title": "Simulaxon",
 "tags": [
  "simulaxon"
 ],
 "timezone": "browser",
 "refresh": "30s",
 "schemaVersion": 39,
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Nodes",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "panels": []
  },
  {
   "type": "state-timeline",
   "title": "Node state",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 24,
    "x": 0,
    "y": 1
   },
   "description": "One row per node the team uses. Unreachable: the node's node_exporter did not answer. Memory pressure: under 10% of the node's memory is available; on the GB10 the GPU draws on this same memory, so a model loading or running there can be killed. In use: reachable, with the team's jobs on it. Idle: reachable, no team jobs. Fuzzball's own node status (Ready, Cordoned, Degraded) is refused to workflow tokens, so these states come from each node's own readings.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (node) (simulaxon_node_state)",
     "refId": "A",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "unreachable",
         "color": "red",
         "index": 0
        },
        "1": {
         "text": "memory pressure",
         "color": "orange",
         "index": 1
        },
        "2": {
         "text": "in use",
         "color": "green",
         "index": 2
        },
        "3": {
         "text": "idle",
         "color": "text",
         "index": 3
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "custom": {
      "fillOpacity": 80,
      "lineWidth": 0
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "auto",
    "mergeValues": true,
    "alignValue": "center",
    "rowHeight": 0.8,
    "legend": {
     "showLegend": false
    },
    "tooltip": {
     "mode": "single"
    }
   }
  },
  {
   "type": "table",
   "title": "Nodes now",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 24,
    "x": 0,
    "y": 7
   },
   "description": "Each node now: its state, the memory it can still hand out, its one-minute load, and the team jobs running on it.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (node, state, jobs) (simulaxon_node_state)",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * max by (node) (simulaxon_node_memory_available_bytes) / max by (node) (simulaxon_node_memory_total_bytes)",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (node) (simulaxon_node_memory_total_bytes)",
     "refId": "C",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (node) (simulaxon_node_load1)",
     "refId": "D",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value #A": true
      },
      "renameByName": {
       "node": "node",
       "state": "state",
       "jobs": "team jobs on it",
       "Value #B": "memory available",
       "Value #C": "memory",
       "Value #D": "load, 1 min"
      },
      "indexByName": {
       "node": 0,
       "state": 1,
       "Value #B": 2,
       "Value #C": 3,
       "Value #D": 4,
       "jobs": 5
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "cellOptions": {
       "type": "auto",
       "wrapText": true
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "state"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "unreachable": {
            "text": "unreachable",
            "color": "red",
            "index": 0
           },
           "memory pressure": {
            "text": "memory pressure",
            "color": "orange",
            "index": 1
           },
           "in use": {
            "text": "in use",
            "color": "green",
            "index": 2
           },
           "idle": {
            "text": "idle",
            "color": "text",
            "index": 3
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "basic"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "memory available"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "memory"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bytes"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "load, 1 min"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 2
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "type": "row",
   "title": "Run steps",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "id": 4,
   "panels": []
  },
  {
   "id": 5,
   "type": "table",
   "title": "Study steps",
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 14
   },
   "description": "One row per observer workflow from the last 6 hours, one column per step, each cell the step's state now; a render cell shows one of its tasks' states. Fuzzball gives the exporter no step times, so this is the current state, not a timeline.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (workflow, job, state) (simulaxon_step_state)",
     "format": "table",
     "instant": true,
     "refId": "A"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true
      }
     }
    },
    {
     "id": "groupingToMatrix",
     "options": {
      "rowField": "workflow",
      "columnField": "job",
      "valueField": "state",
      "emptyValue": "empty"
     }
    },
    {
     "id": "organize",
     "options": {
      "indexByName": {
       "workflow\\job": 0,
       "motions": 1,
       "render": 2,
       "tribe": 3,
       "analyse": 4,
       "maps": 5,
       "app-dataset": 6
      },
      "renameByName": {
       "workflow\\job": "workflow"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "cellOptions": {
       "type": "color-background"
      },
      "align": "center"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "finished": {
         "color": "green",
         "text": "finished"
        },
        "started": {
         "color": "blue",
         "text": "started"
        },
        "running": {
         "color": "blue",
         "text": "running"
        },
        "failed": {
         "color": "red",
         "text": "failed"
        },
        "canceled": {
         "color": "orange",
         "text": "canceled"
        },
        "cancelled": {
         "color": "orange",
         "text": "cancelled"
        },
        "unspecified": {
         "color": "text",
         "text": "unspecified"
        }
       }
      }
     ]
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "workflow"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "auto"
        }
       },
       {
        "id": "custom.align",
        "value": "left"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "type": "row",
   "title": "Failures",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 26
   },
   "panels": [],
   "id": 6
  },
  {
   "type": "table",
   "title": "Recent failures",
   "description": "Every workflow that failed in the last 24 hours: the step that failed first, Fuzzball's error, and the last lines of that step's log. Value is when it failed.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 27
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (workflow, workflow_name, job, task, error, log_tail) (simulaxon_workflow_failure_timestamp_seconds) * 1000",
     "format": "table",
     "instant": true,
     "refId": "A"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value": "failed at",
       "workflow_name": "workflow",
       "workflow": "workflow id",
       "log_tail": "last log lines"
      },
      "indexByName": {
       "Value": 0,
       "workflow_name": 1,
       "job": 2,
       "task": 3,
       "error": 4,
       "log_tail": 5,
       "workflow": 6
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "failed at",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "cellOptions": {
       "type": "auto",
       "wrapText": true
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "failed at"
      },
      "properties": [
       {
        "id": "unit",
        "value": "dateTimeAsLocal"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "id": 7
  },
  {
   "type": "row",
   "title": "GPU jobs",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 37
   },
   "panels": [],
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "GPU utilisation",
   "description": "Share of time a kernel ran (nvidia-smi). It does not say how busy the SMs were.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 38
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "spanNulls": false
     },
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "mean",
      "max"
     ]
    },
    "tooltip": {

  {
   "type": "timeseries",
   "title": "Memory in use on each node",
   "description": "Memory in use on each of the team's two GB10 nodes: total minus available, as the node reports it. GB10 memory is one pool for CPU and GPU, so this includes the planner's weights and KV cache and the renderers' GPU memory, which the containers' own counters miss. The red line is 128 GB.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (node) (simulaxon_node_memory_total_bytes) - max by (node) (simulaxon_node_memory_available_bytes)",
     "legendFormat": "{{node}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 25,
      "lineWidth": 2,
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "red",
        "value": 128000000000.0
       }
      ]
     },
     "max": 128000000000.0
    },
    "overrides": []
   },
   "id": 38
  },
  {
   "type": "timeseries",
   "title": "Container memory per service",
   "description": "Each service's container memory from its cgroup, stacked: the CPU side only, since nvidia-smi on GB10 reports no GPU memory.",

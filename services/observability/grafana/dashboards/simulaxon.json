{
 "uid": "simulaxon",
 "title": "Simulaxon",
 "tags": [
  "simulaxon"
 ],
 "timezone": "browser",
 "refresh": "30s",
 "schemaVersion": 39,
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Failures",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": [],
   "id": 1
  },
  {
   "type": "table",
   "title": "Recent failures",
   "description": "Every workflow that failed in the last 24 hours: the step that failed first, Fuzzball's error, and the last lines of that step's log. Value is when it failed.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (workflow, workflow_name, job, task, error, log_tail) (simulaxon_workflow_failure_timestamp_seconds) * 1000",
     "format": "table",
     "instant": true,
     "refId": "A"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value": "failed at",
       "workflow_name": "workflow",
       "workflow": "workflow id",
       "log_tail": "last log lines"
      },
      "indexByName": {
       "Value": 0,
       "workflow_name": 1,
       "job": 2,
       "task": 3,
       "error": 4,
       "log_tail": 5,
       "workflow": 6
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "failed at",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "cellOptions": {
       "type": "auto",
       "wrapText": true
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "failed at"
      },
      "properties": [
       {
        "id": "unit",
        "value": "dateTimeAsLocal"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "id": 2
  },
  {
   "type": "row",
   "title": "GPU jobs",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 11
   },
   "panels": [],
   "id": 3
  },
  {
   "type": "timeseries",
   "title": "GPU utilisation",
   "description": "Share of time a kernel ran (nvidia-smi). It does not say how busy the SMs were.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 12
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "spanNulls": false
     },
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "simulaxon_gpu_utilization_percent",
     "legendFormat": "{{workflow_name}} / {{job}} {{task}}",
     "refId": "A"
    }
   ],
   "id": 4
  },
  {
   "type": "timeseries",

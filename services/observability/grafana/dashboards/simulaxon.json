  {
   "type": "row",
   "title": "Nodes",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 47
   },
   "id": 1,
   "panels": []
  },
  {
   "type": "state-timeline",
   "title": "Node state",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 24,
    "x": 0,
    "y": 48
   },
   "description": "One row per node the team uses. Unreachable: the node's node_exporter did not answer. Memory pressure: under 10% of the node's memory is available; on the GB10 the GPU draws on this same memory, so a model loading or running there can be killed. In use: reachable, with the team's jobs on it. Idle: reachable, no team jobs. Fuzzball's own node status (Ready, Cordoned, Degraded) is refused to workflow tokens, so these states come from each node's own readings.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (node) (simulaxon_node_state)",
     "refId": "A",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "unreachable",
         "color": "red",
         "index": 0
        },
        "1": {
         "text": "memory pressure",
         "color": "orange",
         "index": 1
        },
        "2": {
         "text": "in use",
         "color": "green",
         "index": 2
        },
        "3": {
         "text": "idle",
         "color": "text",
         "index": 3
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "custom": {
      "fillOpacity": 80,
      "lineWidth": 0
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "auto",
    "mergeValues": true,
    "alignValue": "center",
    "rowHeight": 0.8,
    "legend": {
     "showLegend": false
    },
    "tooltip": {
     "mode": "single"
    }
   }
  },
  {
   "type": "table",
   "title": "Nodes now",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 6,
    "w": 24,
    "x": 0,
    "y": 54
   },
   "description": "Each node now: its state, the memory it can still hand out, its one-minute load, and the team jobs running on it.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (node, state, jobs) (simulaxon_node_state)",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * max by (node) (simulaxon_node_memory_available_bytes) / max by (node) (simulaxon_node_memory_total_bytes)",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (node) (simulaxon_node_memory_total_bytes)",
     "refId": "C",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (node) (simulaxon_node_load1)",
     "refId": "D",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value #A": true
      },
      "renameByName": {
       "node": "node",
       "state": "state",
       "jobs": "team jobs on it",
       "Value #B": "memory available",
       "Value #C": "memory",
       "Value #D": "load, 1 min"
      },
      "indexByName": {
       "node": 0,
       "state": 1,
       "Value #B": 2,
       "Value #C": 3,
       "Value #D": 4,
       "jobs": 5
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "cellOptions": {
       "type": "auto",
       "wrapText": true
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "state"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "unreachable": {
            "text": "unreachable",
            "color": "red",
            "index": 0
           },
           "memory pressure": {
            "text": "memory pressure",
            "color": "orange",
            "index": 1
           },
           "in use": {
            "text": "in use",
            "color": "green",
            "index": 2
           },
           "idle": {
            "text": "idle",
            "color": "text",
            "index": 3
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "basic"
        }
       }
      ]
     },
